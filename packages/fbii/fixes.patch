+
+/// Resources are stored by bare filename too, so strip relative path parts
+/// like `../Images/` from an `<img src>`.
+fn image_key(src: &str) -> String {
+    Path::new(src)
+        .file_name()
+        .and_then(|f| f.to_str())
+        .unwrap_or(src)
+        .to_string()
+}
